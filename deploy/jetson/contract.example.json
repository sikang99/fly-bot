    {"name": "goal_left", "unit": "m"},
    {"name": "velocity_forward", "unit": "m/s"},
    {"name": "velocity_left", "unit": "m/s"},
    {"name": "yaw_rate", "unit": "rad/s"},
    {"name": "clearance_front", "unit": "m"},
    {"name": "clearance_left", "unit": "m"},
    {"name": "clearance_right", "unit": "m"}
  ],
  "outputs": ["vx_m_s", "vy_m_s", "yaw_rad_s"],
