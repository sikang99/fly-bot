{
  "name": "ant-a2-walking-lab",
  "version": "1.0.0",
  "description": "Browser-based Unitree A2 walking and controller laboratory",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:environments": "node --test test/a2-environments.test.js test/a2-detour.test.js test/a2-passage.test.js test/a2-rear-buffer.test.js test/a2-recovery.test.js test/a2-low-step.test.js test/a2-encounter.test.js",
    "jetson:doctor": "python3 deploy/jetson/ant_jetson.py doctor",
    "jetson:test": "python3 -B -m unittest discover -s deploy/jetson -p 'test_*.py' -v",
    "jetson:pack": "python3 deploy/jetson/ant_jetson.py pack",
    "jetson:deploy": "python3 deploy/jetson/ant_jetson.py deploy"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mujoco/mujoco": "^3.13.0",
    "three": "^0.186.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.63.0"
  }
}
